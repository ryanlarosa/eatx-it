rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /invoices/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /incidents/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /handovers/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /assets/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
