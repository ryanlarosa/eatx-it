rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isITStaff() {
      return hasRole(['admin', 'technician']);
    }

    function isInternalUser() {
      return hasRole(['admin', 'technician', 'management', 'viewer']);
    }

    function isSandboxUser() {
      return hasRole(['admin', 'sandbox_user']);
    }

    // Verified official EATX / Bull&Roo Google Workspace email domains
    function isCompanyEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(bullandroo\\.com|byronbathers\\.com|commongroundsdubai\\.com|dmcclounge\\.com|eatx\\.com|encounter\\.ae|encountercoffee\\.ae|encountercoffeeroasters\\.com|frankyinflorence\\.com|frankyspizzeria\\.com|harvestandco\\.com|hawkerboi\\.com|onlyonsundaes\\.com|riseanddawnbakehouse\\.com|splendourfields\\.com|theguilddubai\\.com|thesumofusdubai\\.com|tomandserg\\.com)$');
    }

    function canUseStaffPortal() {
      return isInternalUser() || hasRole(['requester']) || isCompanyEmail();
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isInternalUser());
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid && request.auth.token.email == 'it@eatx.com' && request.resource.data.role == 'admin');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Settings (appConfig readable by authenticated staff portal users for venue/category dropdowns)
    match /settings/{docId} {
      allow read: if isInternalUser() || (docId == 'appConfig' && canUseStaffPortal());
      allow write: if isAdmin();
    }

    // Core IT Collections (strictly internal IT & Management)
    match /{col}/{docId} {
      allow read: if col in [
        'assets', 'logs', 'projects', 'tasks', 'invoices',
        'venues', 'venueVisits', 'employees', 'vendors', 'notifications'
      ] && isInternalUser();

      allow create, update: if col in [
        'assets', 'logs', 'projects', 'tasks', 'invoices',
        'venues', 'venueVisits', 'employees', 'vendors', 'notifications'
      ] && isITStaff();

      allow delete: if col in [
        'assets', 'logs', 'projects', 'tasks', 'invoices',
        'venues', 'venueVisits', 'employees', 'vendors', 'notifications'
      ] && isAdmin();
    }

    // Authenticated Staff Portal: Help Desk Incidents & Asset Requests (NO anonymous/public access)
    match /incidents/{docId} {
      allow read: if canUseStaffPortal();
      allow create: if canUseStaffPortal();
      allow update: if isITStaff();
      allow delete: if isAdmin();
    }

    match /requests/{docId} {
      allow read: if canUseStaffPortal();
      allow create: if canUseStaffPortal();
      allow update: if isITStaff();
      allow delete: if isAdmin();
    }

    // Digital Handover Documents & Pending Signing Links
    match /pendingHandovers/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isITStaff();
      allow update: if isITStaff() || (isSignedIn() && request.resource.data.status == 'Completed');
    }

    match /documents/{docId} {
      allow read: if isInternalUser();
      allow create: if isSignedIn();
      allow update, delete: if isITStaff();
    }

    // Sandbox collections (isolated for testing)
    match /{col}/{docId} {
      allow read, write: if col.matches('sandbox_.*') && isSandboxUser();
    }
  }
}
